# jz-mac-remote 凭证模板
# 复制此文件到 ~/.config/skills/jz-mac-remote/.env 并填入你的值。
# 不要提交 .env 到 git；保持 chmod 600。

# ── 默认连接（未指定 instance 时使用）──
# 改为你的目标 Mac 的 Bonjour 名（在目标 Mac 上运行 scutil --get ComputerName 获取）。
JZ_MAC_REMOTE_DEFAULT_INSTANCE=<your-mac-name>

# ── SSH 身份（默认值）──
# 改为你在目标 Mac 上的用户名。
JZ_MAC_REMOTE_SSH_USER=<your-username>
# 改为你本机 SSH 私钥的路径。
JZ_MAC_REMOTE_SSH_IDENTITY_FILE=~/.ssh/id_ed25519

# ── 按 Bonjour 名覆盖 SSH 用户和 key（可选）──
# 若有多台 Mac 且用户名或 key 不同，按此格式配置。
# 规则：instance 名全大写、连字符改下划线，加 _SSH_USER / _SSH_IDENTITY_FILE 后缀。
# 例如 instance 名为 "my-imac"：
# JZ_MAC_REMOTE_MY_IMAC_SSH_USER=alice
# JZ_MAC_REMOTE_MY_IMAC_SSH_IDENTITY_FILE=~/.ssh/id_ed25519_imac
# 例如 instance 名为 "my-mac-studio"：
# JZ_MAC_REMOTE_MY_MAC_STUDIO_SSH_USER=bob
# JZ_MAC_REMOTE_MY_MAC_STUDIO_SSH_IDENTITY_FILE=~/.ssh/id_rsa_studio

# ── 默认传输目标路径（可选）──
# 文件传到远端时的默认目标目录。不设置则默认为 ~/Desktop。
JZ_MAC_REMOTE_DEFAULT_DEST=~/Desktop
