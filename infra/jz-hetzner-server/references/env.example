# Hetzner Cloud API Token（必填）
# 在 https://console.hetzner.cloud/ → Security → API Tokens 创建
HETZNER_API_TOKEN=

# 默认服务器配置（可选）
# HCLOUD_SERVER_TYPE=cx22
# HCLOUD_LOCATION=nbg1
# HCLOUD_IMAGE=ubuntu-24.04
# HCLOUD_SERVER_PREFIX=server

# SSH 密钥路径覆盖（可选）
# HETZNER_SSH_KEY_PATH=~/.ssh/id_ed25519_hetz_01
