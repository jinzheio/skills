# OVH API 凭证（必填）
# 在 https://api.us.ovhcloud.com/createToken/ 创建
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# OVH API endpoint（默认美国区）
# OVH_API_BASE=https://api.us.ovhcloud.com/1.0

# SSH 公钥内容（必填，rebuild 时注入）
# 注意：是公钥内容，不是路径
# OVH_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3..."

# VPS 配置（可选，有默认值）
# OVH_VPS_PLAN_CODES=  # 逗号分隔，如 "essential,comfort,elite"
# OVH_VPS_DURATION=P1M
# OVH_VPS_PRICING_MODE=default
# OVH_VPS_OS=Ubuntu 24.04
# OVH_VPS_DATACENTERS=  # 逗号分隔，如 "BHS,GRA,SBG"
# OVH_VPS_IMAGE_ID=    # 覆盖自动镜像匹配
# OVH_VPS_DO_NOT_SEND_PASSWORD=true

# SSH 密钥路径覆盖（可选）
# OVH_SSH_KEY_PATH=~/.ssh/id_ed25519_ovh
